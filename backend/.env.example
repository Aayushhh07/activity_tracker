# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# 1. MongoDB Database Connection URL
# For Free MongoDB Atlas Cloud Database (Recommended for Render deployment):
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/activity_tracker?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://admin:YourSecurePassword123@cluster0.mongodb.net/activity_tracker?retryWrites=true&w=majority

# For Local MongoDB (if running locally on your computer):
# MONGODB_URL=mongodb://localhost:27017

# 2. Database Name inside MongoDB
DB_NAME=activity_tracker

# 3. JWT Secret Key (Generate any random 32+ character string for production)
JWT_SECRET=super-secret-jwt-activity-tracker-secret-key-change-in-production-2026

# 4. Allowed Frontend CORS Origins (comma-separated URLs, or * for all)
# Add your deployed Vercel domain here once created
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173
