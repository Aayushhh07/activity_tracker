# ==========================================
# FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# URL pointing to your deployed backend API on Render (including the /api prefix)
# Example: https://activity-tracker-api.onrender.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api

# For local development (leave empty or use /api to utilize Vite proxy):
# VITE_API_URL=/api
